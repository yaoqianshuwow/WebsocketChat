# 阶段 1：编译
FROM golang:1.26-alpine AS builder
RUN apk add --no-cache build-base

WORKDIR /build
COPY app/user/ ./
RUN GOPROXY=https://goproxy.cn,direct CGO_ENABLED=0 go build -o /user-rpc .

# 阶段 2：运行
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /user-rpc /app/user-rpc
COPY deploy/docker-config/user.yaml /app/etc/user.yaml
WORKDIR /app
EXPOSE 9091
CMD ["/app/user-rpc", "-f", "/app/etc/user.yaml"]
