FROM golang:1.26-alpine AS builder
RUN apk add --no-cache build-base
WORKDIR /ws-chat
COPY go.work go.work.sum ./
COPY proto/ proto/
COPY pkg/ pkg/
COPY app/msg-forward/ app/msg-forward/
RUN CGO_ENABLED=0 go build -o /msg-forward ./app/msg-forward/

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /msg-forward /app/msg-forward
COPY deploy/docker-config/msg.yaml /app/etc/msg.yaml
WORKDIR /app
EXPOSE 9092
CMD ["/app/msg-forward", "-f", "/app/etc/msg.yaml"]
