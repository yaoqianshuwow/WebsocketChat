FROM golang:1.26-alpine AS builder
RUN apk add --no-cache build-base
WORKDIR /build
COPY app/voice/ ./
RUN GOPROXY=https://goproxy.cn,direct CGO_ENABLED=0 go build -o /voice-rpc .

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /voice-rpc /app/voice-rpc
COPY deploy/docker-config/voice.yaml /app/etc/voice.yaml
WORKDIR /app
EXPOSE 9095
CMD ["/app/voice-rpc", "-f", "/app/etc/voice.yaml"]
