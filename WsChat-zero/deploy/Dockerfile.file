FROM golang:1.26-alpine AS builder
RUN apk add --no-cache build-base
WORKDIR /build
COPY app/file/ ./
RUN GOPROXY=https://goproxy.cn,direct CGO_ENABLED=0 go build -o /file-rpc .

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /file-rpc /app/file-rpc
COPY deploy/docker-config/file.yaml /app/etc/file.yaml
WORKDIR /app
EXPOSE 9094
CMD ["/app/file-rpc", "-f", "/app/etc/file.yaml"]
