# 阶段 1：编译
FROM golang:1.26-alpine AS builder
RUN apk add --no-cache build-base

WORKDIR /build
COPY go.work go.work.sum ./
COPY app/ ./app/
COPY pkg/ ./pkg/
RUN GOPROXY=https://goproxy.cn,direct CGO_ENABLED=0 go build -o /gateway ./app/gateway

# 阶段 2：运行
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /gateway /app/gateway
COPY deploy/docker-config/gateway-api.yaml /app/etc/gateway-api.yaml
WORKDIR /app
EXPOSE 8888
CMD ["/app/gateway", "-f", "/app/etc/gateway-api.yaml"]
