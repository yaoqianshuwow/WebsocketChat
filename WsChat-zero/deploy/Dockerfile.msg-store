FROM golang:1.26-alpine AS builder
RUN apk add --no-cache build-base
WORKDIR /ws-chat
COPY go.work go.work.sum ./
COPY proto/ proto/
COPY pkg/ pkg/
COPY app/msg-store/ app/msg-store/
RUN CGO_ENABLED=0 go build -o /msg-store ./app/msg-store/cmd/

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /msg-store /app/msg-store
COPY deploy/docker-config/msg-store.yaml /app/etc/msg-store.yaml
WORKDIR /app
EXPOSE 8094
CMD ["/app/msg-store", "-f", "/app/etc/msg-store.yaml"]
