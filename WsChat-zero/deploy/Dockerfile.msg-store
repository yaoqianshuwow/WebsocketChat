FROM golang:1.26-alpine AS builder
RUN apk add --no-cache build-base
WORKDIR /build
COPY app/msg-store/ ./
RUN GOPROXY=https://goproxy.cn,direct CGO_ENABLED=0 go build -o /msg-store ./cmd/

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /msg-store /app/msg-store
COPY deploy/docker-config/msg-store.yaml /app/etc/msg-store.yaml
WORKDIR /app
EXPOSE 8094
CMD ["/app/msg-store", "-f", "/app/etc/msg-store.yaml"]
