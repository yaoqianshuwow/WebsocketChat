FROM golang:1.26-alpine AS builder

RUN apk add --no-cache build-base

WORKDIR /src
COPY app/ppt-agent/ /src/

RUN GOPROXY=https://goproxy.cn,direct CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /ppt-agent .

FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app
COPY --from=builder /src /app
COPY --from=builder /ppt-agent /app/ppt-agent

EXPOSE 8123
CMD ["/app/ppt-agent", "-env", "prod"]
