FROM golang:1.26-alpine AS builder
RUN apk add --no-cache build-base
WORKDIR /build
COPY app/friend/ ./
RUN GOPROXY=https://goproxy.cn,direct CGO_ENABLED=0 go build -o /friend-rpc .

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /friend-rpc /app/friend-rpc
COPY deploy/docker-config/friend.yaml /app/etc/friend.yaml
WORKDIR /app
EXPOSE 9093
CMD ["/app/friend-rpc", "-f", "/app/etc/friend.yaml"]
